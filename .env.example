# Absolute path to the directory holding subject data (input/, output/, dsar.sqlite).
# Keep this OUTSIDE any cloud-synced folder (OneDrive/Dropbox/iCloud).
DSAR_DATA_DIR=/Users/you/DSARClassifier/data

# Who runs the pipeline, as recorded in the audit log. Defaults to the OS login.
# DSAR_OPERATOR=Jane Operator

# Optional: override the local Ollama daemon URL.
# OLLAMA_URL=http://localhost:11434

# Optional: folder holding your organisation's Personal Data Report.docx (and other response
# templates) for the web app's Report page. Defaults to Templates/ in the project folder,
# which holds the employee response set (see Templates/README.md). Set this only to use
# another set. A case can override it with its own data/templates/Personal Data Report.docx.
# DSAR_TEMPLATES_DIR=/Users/you/DSAR templates

# Optional: folder holding each case's prepared response documents, as
# <root>/<CASE-REF>/Templates and <root>/<CASE-REF>/Output. The case page's release
# checklist reads them (never changes them) to check the letter and reports are ready.
# DSAR_CASE_DOCS_ROOT=/Users/you/DSAR
