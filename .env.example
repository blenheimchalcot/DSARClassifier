# Absolute path to the directory holding subject data (input/, output/, dsar.sqlite).
# Keep this OUTSIDE any cloud-synced folder (OneDrive/Dropbox/iCloud).
DSAR_DATA_DIR=/Users/you/DSARClassifier/data

# Who runs the pipeline, as recorded in the audit log. Defaults to the OS login.
# DSAR_OPERATOR=Jane Operator

# Optional: override the local Ollama daemon URL.
# OLLAMA_URL=http://localhost:11434
